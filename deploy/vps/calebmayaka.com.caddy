# calebmayaka.com (portfolio + blog). App: /srv/apps/calebmayaka.com (container "calebmayaka").
# Installed at /srv/proxy/sites/calebmayaka.com.caddy (source: deploy/vps/ in the repo).
calebmayaka.com {
	encode zstd gzip

	handle /static/* {
		root * /srv/apps/calebmayaka.com
		file_server
		# File names carry a content hash (ManifestStaticFilesStorage), so cache for a year.
		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle /media/* {
		root * /srv/apps/calebmayaka.com
		file_server
		header Cache-Control "public, max-age=86400"
	}

	handle {
		reverse_proxy calebmayaka:8000
	}

	log {
		output file /data/logs/calebmayaka.com.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}

# One canonical host: www redirects to the bare domain.
www.calebmayaka.com {
	redir https://calebmayaka.com{uri} permanent
}
